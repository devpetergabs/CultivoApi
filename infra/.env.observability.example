# --- DevLake core ---
DEVLAKE_VERSION=v1.0.2
DEVLAKE_ENCRYPTION_SECRET=REPLACE_WITH_128_CHAR_SECRET
TZ=America/Sao_Paulo

DEVLAKE_DB_HOST=devlake-db
DEVLAKE_DB_PORT=3306
DEVLAKE_DB_NAME=lake
DEVLAKE_DB_USER=merico
DEVLAKE_DB_PASSWORD=merico
DEVLAKE_DB_ROOT_PASSWORD=admin

DEVLAKE_CONFIG_UI_PORT=4000
DEVLAKE_GRAFANA_PORT=3002
DEVLAKE_API_PORT=8080
GRAFANA_ROOT_URL=http://127.0.0.1:3002

# --- Jira placeholders ---
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=REPLACE_ME
JIRA_BOARD_ID=000
JIRA_PROJECT_KEY=CULTIVO

# --- GitHub placeholders ---
GITHUB_ORG=your-org
GITHUB_OWNER=your-owner
GITHUB_TOKEN=REPLACE_ME
GITHUB_REPO_BACKEND=cultivo-backend
GITHUB_REPO_FRONTEND=cultivo-frontend
GITHUB_DEPLOYMENT_WORKFLOW_REGEX=(deploy|release|publish)
GITHUB_PRODUCTION_JOB_REGEX=(prod|production)
DORA_PROJECT_NAME=cultivo-engineering-pilot
DORA_TIME_WINDOW_DAYS=90

# --- SonarQube optional quality stack ---
SONARQUBE_VERSION=2025.1.1-community
SONARQUBE_PORT=9000
SONARQUBE_DB_HOST=sonarqube-db
SONARQUBE_DB_PORT=5432
SONARQUBE_DB_NAME=sonarqube
SONARQUBE_DB_USER=sonarqube
SONARQUBE_DB_PASSWORD=sonarqube
SONARQUBE_JDBC_URL=jdbc:postgresql://sonarqube-db:5432/sonarqube
SONARQUBE_JDBC_USERNAME=sonarqube
SONARQUBE_JDBC_PASSWORD=sonarqube
SONARQUBE_CONTEXT_PATH=/
